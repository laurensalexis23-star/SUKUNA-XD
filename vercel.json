{
  "version": 2,
  "name": "sukuna-xd-pairing",
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "functions": {
    "api/pair.js": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}